{
  "name": "wibit-create",
  "private": true,
  "version": "0.1.0",
  "description": "Configurateur 3D de parcs aquatiques gonflables Wibit avec génération aléatoire cohérente (MVP)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "node server/index.js",
    "dev:api": "PORT=3001 node server/index.js"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/three": "0.169.0",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
